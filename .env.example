# Copy to .env.local and fill in. NEVER commit real values.
# Only the public (anon) Supabase key belongs in frontend code.
# The service-role key must never appear in this project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Shown on the privacy page as the contact address. Set before launch.
VITE_CONTACT_EMAIL=

# Public key for phone notifications. See docs/PUSH_SETUP.md. Leave empty to hide the setting.
VITE_VAPID_PUBLIC_KEY=
